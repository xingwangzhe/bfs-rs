{
  "name": "@xingwangzhe/bfs-rs",
  "version": "0.3.0",
  "description": "Rust BFS on compressed adjacency list with Rayon parallelism",
  "keywords": [
    "bfs",
    "graph",
    "napi-rs",
    "rayon",
    "rust"
  ],
  "license": "MIT",
  "author": "xingwangzhe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingwangzhe/bfs-rs.git"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "bfs-rs.*.node"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node --test bfs.test.mjs",
    "benchmark": "node benchmark.mjs",
    "lint": "oxlint",
    "artifacts": "napi artifacts",
    "build:pgo": "node scripts/build-pgo.mjs",
    "benchmark:pgo": "node scripts/build-pgo.mjs --compare"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@oxc-node/core": "^0.1.7",
    "ava": "^8.0.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "tar": "^7.5.22"
  },
  "napi": {
    "binaryName": "bfs-rs",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18"
  }
}
